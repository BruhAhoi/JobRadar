generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  passwordHash       String
  name               String
  isVerified         Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  timezone           String               @default("Asia/Ho_Chi_Minh")
  jobs               JobApplication[]
  PasswordResetToken PasswordResetToken[]
  refreshTokens      RefreshToken[]
}

model JobApplication {
  id             String          @id @default(uuid())
  userId         String
  companyName    String          @db.VarChar(200)
  position       String          @db.VarChar(200)
  status         Status          @default(APPLIED)
  source         Source          @default(OTHER)
  jobUrl         String?
  salaryNote     String?
  notes          String?
  appliedAt      DateTime        @default(now())
  deadlineAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  interviewNotes InterviewNote[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, appliedAt(sort: Desc)])
  @@index([userId, status])
}

model InterviewNote {
  id        String         @id @default(uuid())
  jobId     String
  userId    String
  content   String
  type      NoteType       @default(IMPRESSION)
  createdAt DateTime       @default(now())
  job       JobApplication @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Status {
  APPLIED
  PHONE_SCREEN
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  DECLINED
}

enum Source {
  ITVIEC
  TOPCV
  LINKEDIN
  REFERRAL
  OTHER
}

enum NoteType {
  QUESTION
  ANSWER
  IMPRESSION
  FOLLOW_UP
}
